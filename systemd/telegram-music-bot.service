[Unit]
Description=Telegram Music Bot
Documentation=https://github.com/your-user/telegram-music-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegram
Group=telegram
WorkingDirectory=/opt/telegram-music-bot
EnvironmentFile=/opt/telegram-music-bot/.env
ExecStart=/opt/telegram-music-bot/venv/bin/python bot.py
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
